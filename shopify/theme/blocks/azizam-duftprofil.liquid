{{ 'azizam.css' | asset_url | stylesheet_tag }}
{%- comment -%} Duftprofil aus den Produkt-Metafeldern (namespace azizam). Fehlende Felder werden ausgelassen. {%- endcomment -%}
{%- assign p = closest.product | default: product -%}
{%- assign m = p.metafields.azizam -%}
<div class="az-profil" {{ block.shopify_attributes }}>
  {%- if m.familie.value != blank -%}<div class="az-profil__fam">{{ m.familie.value }}</div>{%- endif -%}
  {%- assign noten = m.noten.value -%}
  {%- if noten != blank -%}<p class="az-profil__notes"><span class="visually-hidden">Hauptnoten: </span>{{ noten | join: ' · ' }}</p>{%- endif -%}
  <dl class="az-profil__grid">
    {%- if m.tageszeit.value != blank -%}<dt>Tageszeit</dt><dd>{{ m.tageszeit.value }}</dd>{%- endif -%}
    {%- if m.saison.value != blank -%}<dt>Saison</dt><dd>{{ m.saison.value }}</dd>{%- endif -%}
    {%- if m.anlass.value != blank -%}<dt>Passt zu</dt><dd>{{ m.anlass.value | join: ', ' }}</dd>{%- endif -%}
  </dl>
  {%- if block.settings.oil_text != blank -%}<p class="az-profil__oil">{{ block.settings.oil_text }}</p>{%- endif -%}
</div>

{% schema %}
{
  "name": "Azizam Duftprofil",
  "settings": [
    { "type": "text", "id": "oil_text", "label": "Hinweis", "default": "Rund 30 % Duftöl." }
  ],
  "presets": [{ "name": "Azizam Duftprofil" }]
}
{% endschema %}
