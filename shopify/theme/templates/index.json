    "faq": {
      "type": "azizam-faq",
      "settings": {
        "heading": "Gut zu wissen",
        "text": "Kurz und ehrlich beantwortet. Fehlt deine Frage? Schreib uns.",
        "kontakt_label": "Frage stellen",
        "kontakt_link": "/pages/contact",
        "erste_offen": false,
        "anker": "faq"
      },
      "blocks": {
        "q01": {
          "type": "frage",
          "settings": {
            "frage": "Was ist Azizam?",
            "antwort": "<p>Parfum mit rund 30 % Duftöl, in Deutschland abgefüllt. „Azizam“ ist persisch und heißt „mein Schatz“.</p>"
          }
        },
        "q02": {
          "type": "frage",
          "settings": {
            "frage": "Was bringen 30 % Duftöl?",
            "antwort": "<p>Bei Eau de Parfum sind meist 12 bis 18 % üblich. Mit mehr Duftöl bleibt der Duft näher an der Haut und hält länger, ohne laut zu sein.</p>"
          }
        },
        "q03": {
          "type": "frage",
          "settings": {
            "frage": "Ich kann online nicht riechen. Wie finde ich meinen Duft?",
            "antwort": "<p>Mach den <a href=\"#duftberater\">Duftberater</a>: ein paar kurze Fragen, dann bekommst du passende Vorschläge. Oder teste erst: Jeden Duft gibt es als 10-ml-Flasche, und im <a href=\"/products/discovery-set\">Discovery Set</a> stellst du dir drei Düfte à 5 ml zusammen. Den Preis des Sets bekommst du als Gutschein für deine nächste 30- oder 50-ml-Flasche zurück.</p>"
          }
        },
        "q04": {
          "type": "frage",
          "settings": {
            "frage": "Welche Größen gibt es?",
            "antwort": "<p>10 ml zum Testen und für unterwegs, dazu 30 ml und 50 ml. Je größer die Flasche, desto günstiger der Milliliter. Den Preis pro 100 ml siehst du bei jedem Preis.</p>"
          }
        },
        "q05": {
          "type": "frage",
          "settings": {
            "frage": "Was kostet der Versand?",
            "antwort": "<p>Ab 20 € Bestellwert verschicken wir kostenlos, darunter kostet der Versand 4,95 €. Wir liefern mit DHL innerhalb Deutschlands, in der Regel in 2–4 Werktagen.</p>"
          }
        },
        "q06": {
          "type": "frage",
          "settings": {
            "frage": "Kann ich zurückgeben?",
            "antwort": "<p>Ja, du hast 14 Tage Widerrufsrecht. Wie es genau funktioniert, steht in der <a href=\"/policies/refund-policy\">Widerrufsbelehrung</a>.</p>"
          }
        },
        "q07": {
          "type": "frage",
          "settings": {
            "frage": "Wie kann ich bezahlen?",
            "antwort": "<p>Zum Beispiel mit PayPal oder Klarna. Alle Möglichkeiten siehst du an der Kasse.</p>"
          }
        },
        "q08": {
          "type": "frage",
          "settings": {
            "frage": "Warum steht keine Umsatzsteuer auf der Rechnung?",
            "antwort": "<p>Azizam ist ein Kleinunternehmen. Nach § 19 UStG berechnen wir keine Umsatzsteuer. Der Preis, den du siehst, ist der Endpreis. Unter 20 € kommt nur der Versand dazu.</p>"
          }
        },
        "q09": {
          "type": "frage",
          "settings": {
            "frage": "Wann kommen die anderen Düfte?",
            "antwort": "<p>Wir bringen die Düfte nach und nach heraus. Merk dir in der <a href=\"#warteliste\">Warteliste</a> vor, was dich neugierig macht, dann erfährst du es als Erstes.</p>"
          }
        },
        "q10": {
          "type": "frage",
          "settings": {
            "frage": "Wie trage ich Parfum am besten auf?",
            "antwort": "<p>Auf Hals, Handgelenke oder Nacken sprühen und nicht verreiben. Auf eingecremter Haut hält ein Duft meist länger. Weniger ist oft mehr: Zwei, drei Sprühstöße reichen.</p>"
          }
        },
        "q11": {
          "type": "frage",
          "settings": {
            "frage": "Wie erreiche ich euch?",
            "antwort": "<p>Am einfachsten über das <a href=\"/pages/contact\">Kontaktformular</a>. Wir antworten in der Regel innerhalb von 1–2 Werktagen.</p>"
          }
        }
      },
