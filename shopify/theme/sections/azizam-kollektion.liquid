{{ 'azizam.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Produktraster mit Filter nach Duftrichtung. Auf einer Kollektionsseite zeigt es diese Kollektion,
  sonst die gewählte (leer = alle Produkte). Filter laufen im Browser, ohne Neuladen.
{%- endcomment -%}
{%- liquid
  assign source = section.settings.collection
  if source == blank and collection != blank
    assign source = collection
  endif
  if source == blank
    assign source = collections.all
  endif
  assign on_collection = false
  if collection != blank and section.settings.collection == blank and collection.handle != 'all'
    assign on_collection = true
  endif
-%}
<section class="az az-section az-kol" id="duefte" aria-labelledby="az-kol-{{ section.id }}">
  <div class="az-wrap">
    <div class="az-kol__head">
      <div>
        {%- if section.settings.kicker != blank -%}<p class="az-kicker">{{ section.settings.kicker }}</p>{%- endif -%}
        <h2 id="az-kol-{{ section.id }}" class="az-h az-kol__title">{% if on_collection %}{{ source.title }}{% else %}{{ section.settings.heading }}{% endif %}</h2>
        {%- if on_collection and source.description != blank -%}<div class="az-kol__desc">{{ source.description }}</div>{%- endif -%}
      </div>
      {%- unless on_collection -%}
        <div class="az-kol__filter" role="group" aria-label="Nach Duftrichtung filtern">
          <button type="button" class="az-chip" aria-pressed="true" data-filter="alle">Alle</button>
          {%- for block in section.blocks -%}
            <button type="button" class="az-chip" aria-pressed="false" data-filter="{{ block.settings.label | handleize }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</button>
          {%- endfor -%}
        </div>
      {%- endunless -%}
    </div>
    <div class="az-grid" data-az-grid>
      {%- assign disc = all_products['discovery-set'] -%}
      {%- if on_collection == false and disc != blank and disc.available -%}
        <a class="az-card az-card--disc" href="{{ disc.url }}" data-familie="alle">
          <span class="az-card__media az-disc-tile">
            <span class="az-disc-tile__kicker">Nicht sicher?</span>
            <span class="az-disc-tile__title">Discovery Set</span>
            <span class="az-disc-tile__sub">3 Düfte deiner Wahl · je 5 ml</span>
            <span class="az-disc-tile__price">{{ disc.price | money }}</span>
            <span class="az-disc-tile__note">Den Betrag bekommst du als Gutschein für deine große Flasche zurück.</span>
            <span class="az-disc-tile__cta">Set zusammenstellen</span>
          </span>
        </a>
      {%- endif -%}
      {%- for p in source.products limit: section.settings.limit -%}
        {%- if p.type == 'Probenset' -%}{%- continue -%}{%- endif -%}
        {%- liquid
          assign eager = false
          if forloop.index0 < 4
            assign eager = true
          endif
        -%}
        {%- render 'azizam-card', product: p, eager: eager -%}
      {%- else -%}
        <p class="az-empty">Bald verfügbar.</p>
      {%- endfor -%}
    </div>
  </div>
</section>
<script>
  (function () {
    var root = document.getElementById('az-kol-{{ section.id }}').closest('section');
    var chips = root.querySelectorAll('.az-chip');
    var cards = root.querySelectorAll('.az-card');
    chips.forEach(function (c) {
      c.addEventListener('click', function () {
        var f = c.dataset.filter;
        chips.forEach(function (x) { x.setAttribute('aria-pressed', x === c); });
        cards.forEach(function (k) { k.hidden = !(f === 'alle' || k.dataset.familie === f); });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Azizam Kollektion",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Überzeile", "default": "19 Düfte · drei Richtungen" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Die Kollektion" },
    { "type": "collection", "id": "collection", "label": "Kollektion (leer = alle bzw. aktuelle Kollektion)" },
    { "type": "range", "id": "limit", "label": "Anzahl", "min": 4, "max": 50, "step": 1, "default": 24 }
  ],
  "blocks": [{ "type": "filter", "name": "Filter", "settings": [
    { "type": "text", "id": "label", "label": "Duftrichtung (genau wie im Metafeld)" }
  ] }],
  "presets": [{ "name": "Azizam Kollektion" }]
}
{% endschema %}
