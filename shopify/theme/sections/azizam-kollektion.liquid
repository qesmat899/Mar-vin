{{ 'azizam.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Produktraster mit Filter nach Duftrichtung. Auf einer Kollektionsseite zeigt es diese Kollektion,
  sonst die gewählte (leer = alle Produkte). Filter laufen im Browser, ohne Neuladen.
  Drop-Teaser: Blöcke „Dunkle Karte“ erscheinen nach den Produkten (nur außerhalb von Kollektionsseiten),
  darunter die Warteliste (Shopify-Kundenformular, Tags: newsletter, warteliste, interesse-<Kennung>).
{%- endcomment -%}
{%- liquid
  assign source = section.settings.collection
  if source == blank and collection != blank
    assign source = collection
  endif
  if source == blank
    assign source = collections.all
  endif
  assign on_collection = false
  if collection != blank and section.settings.collection == blank and collection.handle != 'all'
    assign on_collection = true
  endif
  assign dark_count = 0
  unless on_collection
    for block in section.blocks
      if block.type == 'dunkel'
        assign dark_count = dark_count | plus: 1
      endif
    endfor
  endunless
-%}
<section class="az az-section az-kol" id="duefte" aria-labelledby="az-kol-{{ section.id }}">
  <div class="az-wrap">
    <div class="az-kol__head">
      <div>
        {%- if section.settings.kicker != blank -%}<p class="az-kicker">{{ section.settings.kicker }}</p>{%- endif -%}
        <h2 id="az-kol-{{ section.id }}" class="az-h az-kol__title">{% if on_collection %}{{ source.title }}{% else %}{{ section.settings.heading }}{% endif %}</h2>
        {%- if on_collection and source.description != blank -%}<div class="az-kol__desc">{{ source.description }}</div>{%- endif -%}
      </div>
      {%- unless on_collection -%}
        <div class="az-kol__filter" role="group" aria-label="Nach Duftrichtung filtern">
          <button type="button" class="az-chip" aria-pressed="true" data-filter="alle">Alle</button>
          {%- for block in section.blocks -%}
            {%- if block.type != 'filter' -%}{%- continue -%}{%- endif -%}
            <button type="button" class="az-chip" aria-pressed="false" data-filter="{{ block.settings.label | handleize }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</button>
          {%- endfor -%}
        </div>
      {%- endunless -%}
    </div>
    <div class="az-grid" data-az-grid>
      {%- assign disc = all_products['discovery-set'] -%}
      {%- if on_collection == false and disc != blank and disc.available -%}
        <a class="az-card az-card--disc" href="{{ disc.url }}" data-familie="alle">
          <span class="az-card__media az-disc-tile">
            <span class="az-disc-tile__kicker">Nicht sicher?</span>
            <span class="az-disc-tile__title">Discovery Set</span>
            <span class="az-disc-tile__sub">3 Düfte deiner Wahl · je 5 ml</span>
            <span class="az-disc-tile__price">{{ disc.price | money }}</span>
            <span class="az-disc-tile__note">Den Betrag bekommst du als Gutschein für deine große Flasche zurück.</span>
            <span class="az-disc-tile__cta">Set zusammenstellen</span>
          </span>
        </a>
      {%- endif -%}
      {%- assign shown = 0 -%}
      {%- for p in source.products limit: section.settings.limit -%}
        {%- if p.type == 'Probenset' -%}{%- continue -%}{%- endif -%}
        {%- liquid
          assign shown = shown | plus: 1
          assign eager = false
          if forloop.index0 < 4
            assign eager = true
          endif
        -%}
        {%- render 'azizam-card', product: p, eager: eager -%}
      {%- else -%}
        {%- if dark_count == 0 -%}<p class="az-empty">Bald verfügbar.</p>{%- endif -%}
      {%- endfor -%}
      {%- if dark_count > 0 -%}
        {%- assign dark_i = shown -%}
        {%- for block in section.blocks -%}
          {%- if block.type != 'dunkel' -%}{%- continue -%}{%- endif -%}
          {%- liquid
            assign dark_i = dark_i | plus: 1
            assign nr = dark_i
            if dark_i < 10
              assign nr = dark_i | prepend: '0'
            endif
          -%}
          {%- render 'azizam-dunkel', block: block, nr: nr, cta: section.settings.dark_cta -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if dark_count > 0 -%}
      <div class="az-wl" id="warteliste">
        <div>
          {%- if section.settings.wl_kicker != blank -%}<p class="az-kicker">{{ section.settings.wl_kicker }}</p>{%- endif -%}
          <h3 class="az-h az-wl__title">{{ section.settings.wl_heading }}</h3>
          {%- if section.settings.wl_text != blank -%}<p class="az-wl__text">{{ section.settings.wl_text }}</p>{%- endif -%}
        </div>
        <div>
          {%- form 'customer', id: 'AzizamWarteliste', class: 'az-liste__form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter,warteliste" data-az-wl-tags data-base="newsletter,warteliste">
            {%- if form.posted_successfully? -%}
              <p class="az-form-msg" role="status">{{ section.settings.wl_success }}</p>
            {%- else -%}
              <p class="az-wl__picked" data-az-wl-picked hidden></p>
              <label for="AzizamWarteliste-email" class="az-visually-hidden">E-Mail-Adresse</label>
              <div class="az-form">
                <input id="AzizamWarteliste-email" type="email" name="contact[email]" required autocomplete="email" placeholder="Deine E-Mail-Adresse">
                <button type="submit">{{ section.settings.wl_button }}</button>
              </div>
              {%- if form.errors -%}<p class="az-form-msg" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
              <p class="az-form-note">{{ section.settings.wl_note }}{% if shop.privacy_policy %} <a href="{{ shop.privacy_policy.url }}">Datenschutz</a>{% endif %}</p>
            {%- endif -%}
          {%- endform -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>
<script>
  (function () {
    var root = document.getElementById('az-kol-{{ section.id }}').closest('section');
    var chips = root.querySelectorAll('.az-chip');
    var cards = root.querySelectorAll('.az-card');
    chips.forEach(function (c) {
      c.addEventListener('click', function () {
        var f = c.dataset.filter;
        chips.forEach(function (x) { x.setAttribute('aria-pressed', x === c); });
        cards.forEach(function (k) { k.hidden = !(f === 'alle' || k.dataset.familie === f); });
      });
    });
    var tags = root.querySelector('[data-az-wl-tags]');
    var picked = root.querySelector('[data-az-wl-picked]');
    var on = {{ section.settings.dark_cta_on | default: 'Vorgemerkt' | json }};
    var off = {{ section.settings.dark_cta | default: 'Vormerken' | json }};
    var pre = {{ section.settings.wl_picked | default: 'Vorgemerkt:' | json }};
    root.querySelectorAll('[data-az-dark]').forEach(function (d) {
      d.addEventListener('click', function () {
        var now = d.getAttribute('aria-pressed') !== 'true';
        d.setAttribute('aria-pressed', now);
        var cta = d.querySelector('[data-az-dark-cta]');
        if (cta) cta.textContent = now ? on : off;
        var sel = [].slice.call(root.querySelectorAll('[data-az-dark][aria-pressed="true"]'));
        if (tags) tags.value = [tags.dataset.base].concat(sel.map(function (x) { return 'interesse-' + x.dataset.azDark; })).join(',');
        if (picked) {
          picked.hidden = sel.length === 0;
          picked.textContent = pre + ' ' + sel.map(function (x) { return 'N° ' + x.dataset.nr; }).join(', ');
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Azizam Kollektion",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Überzeile", "default": "19 Düfte · drei Richtungen" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Die Kollektion" },
    { "type": "collection", "id": "collection", "label": "Kollektion (leer = alle bzw. aktuelle Kollektion)" },
    { "type": "range", "id": "limit", "label": "Anzahl", "min": 4, "max": 50, "step": 1, "default": 24 },
    { "type": "header", "content": "Dunkle Karten" },
    { "type": "text", "id": "dark_cta", "label": "Knopf auf der Karte", "default": "Vormerken" },
    { "type": "text", "id": "dark_cta_on", "label": "Knopf nach dem Vormerken", "default": "Vorgemerkt" },
    { "type": "header", "content": "Warteliste (nur mit dunklen Karten)" },
    { "type": "text", "id": "wl_kicker", "label": "Überzeile", "default": "Warteliste" },
    { "type": "text", "id": "wl_heading", "label": "Überschrift", "default": "Vierzehn warten noch im Dunkeln." },
    { "type": "textarea", "id": "wl_text", "label": "Text", "default": "Merk dir die Karten vor, die dich neugierig machen, und trag dich ein. Du erfährst es zuerst, wenn der nächste Duft enthüllt wird." },
    { "type": "text", "id": "wl_picked", "label": "Text vor der Auswahl", "default": "Vorgemerkt:" },
    { "type": "text", "id": "wl_button", "label": "Button", "default": "Benachrichtige mich" },
    { "type": "textarea", "id": "wl_note", "label": "Hinweis unter dem Feld", "default": "Mit dem Eintragen willigst du ein, E-Mails von Azizam zu erhalten. Abmelden geht jederzeit über den Link in jeder E-Mail." },
    { "type": "text", "id": "wl_success", "label": "Bestätigung", "default": "Danke. Du erfährst es zuerst." }
  ],
  "blocks": [
    { "type": "filter", "name": "Filter", "settings": [
      { "type": "text", "id": "label", "label": "Duftrichtung (genau wie im Metafeld)" }
    ] },
    { "type": "dunkel", "name": "Dunkle Karte", "settings": [
      { "type": "text", "id": "hinweis", "label": "Hinweis (sichtbar)", "default": "Rauch. Leder." },
      { "type": "text", "id": "familie", "label": "Duftrichtung (genau wie beim Filter)" },
      { "type": "text", "id": "status", "label": "Zeile unten", "default": "Enthüllung folgt" },
      { "type": "text", "id": "code", "label": "Kennung für die Warteliste (Tag interesse-…)", "info": "Neutral halten, z. B. n07: Sie steht im Seitenquelltext." },
      { "type": "text", "id": "intern", "label": "Interne Notiz (nie sichtbar)", "info": "Zum Beispiel der Duftname, damit du die Karte zuordnen kannst." }
    ] }
  ],
  "presets": [{ "name": "Azizam Kollektion" }]
}
{% endschema %}
