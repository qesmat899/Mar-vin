{{ 'azizam.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Passwortseite (Shop noch zu): Flakon-Video als Bühne, Schriftzug, Vorgeschmack auf Drop 1, Warteliste.
  Eintragen = Shopify-Kunde mit Tags newsletter, warteliste, prelaunch (Einwilligung über den Hinweis darunter).
  Countdown nur, wenn ein Startdatum eingetragen ist. Passwort-Dialog kommt aus layout/password.liquid.
  Lichtband auf dem Schriftzug nach Magic UI „shine“ (MIT), Eingabefeld wie die Berater-Felder.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign drop = s.kollektion | default: collections['drop-1'] -%}
<section class="az az-pw" aria-labelledby="az-pw-{{ section.id }}">
  <div class="az-pw__media" aria-hidden="true">
    {%- if s.poster != blank -%}
      {{ s.poster | image_url: width: 1600 | image_tag: class: 'az-pw__still', loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1600', sizes: '100vw', alt: '' }}
    {%- endif -%}
    {%- if s.video_url != blank -%}
      <video class="az-pw__video" muted playsinline webkit-playsinline preload="metadata" disablepictureinpicture disableremoteplayback tabindex="-1">
        {%- if s.video_url_mobile != blank -%}<source src="{{ s.video_url_mobile }}" type="video/mp4" media="(max-width: 899px)">{%- endif -%}
        <source src="{{ s.video_url }}" type="video/mp4">
      </video>
    {%- endif -%}
    <span class="az-pw__shade"></span>
  </div>

  <div class="az-pw__inner">
    {%- if s.kicker != blank -%}<p class="az-kicker az-pw__kicker">{{ s.kicker }}</p>{%- endif -%}
    <p class="az-pw__word" aria-hidden="true">{{ s.wortmarke }}</p>
    {%- if s.persisch != blank -%}
      <p class="az-pw__fa"><span lang="fa">{{ s.persisch }}</span> {{ s.bedeutung }}</p>
    {%- endif -%}
    <h1 id="az-pw-{{ section.id }}" class="az-h az-pw__title">{{ s.heading }}</h1>
    {%- if s.text != blank -%}<p class="az-pw__text">{{ s.text }}</p>{%- endif -%}

    {%- if s.start_datum != blank -%}
      <div class="az-pw__count" data-az-count="{{ s.start_datum | escape }}" hidden>
        <span><b data-t="d">0</b>Tage</span><span><b data-t="h">0</b>Std.</span><span><b data-t="m">0</b>Min.</span><span><b data-t="s">0</b>Sek.</span>
      </div>
    {%- endif -%}

    <div class="az-pw__form">
      {%- form 'customer', id: 'AzizamPrelaunch', class: 'az-pw__formwrap' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,warteliste,prelaunch">
        {%- if form.posted_successfully? -%}
          <p class="az-pw__ok" role="status">{{ s.erfolg }}</p>
        {%- else -%}
          <label for="AzizamPrelaunch-email" class="az-visually-hidden">E-Mail-Adresse</label>
          <div class="az-pw__field">
            <input id="AzizamPrelaunch-email" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ s.platzhalter }}">
            <button type="submit">{{ s.button }}<span aria-hidden="true">→</span></button>
          </div>
          {%- if form.errors -%}<p class="az-pw__err" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
          <p class="az-pw__note">{{ s.hinweis }}{% if shop.privacy_policy %} <a href="{{ shop.privacy_policy.url }}">Datenschutz</a>{% endif %}</p>
        {%- endif -%}
      {%- endform -%}
    </div>

    {%- if s.fakten != blank -%}
      <p class="az-pw__facts">{%- assign teile = s.fakten | split: '·' -%}{%- for t in teile -%}{%- assign tt = t | strip -%}{%- if tt != blank -%}<span>{{ tt }}</span>{%- endif -%}{%- endfor -%}</p>
    {%- endif -%}
  </div>

  {%- if s.drop_zeigen and drop != blank and drop.products_count > 0 -%}
    <p class="az-pw__names"><span class="az-pw__droplbl">{{ s.drop_titel }}</span>
      {%- for p in drop.products limit: 5 -%}<span>{{ p.title }}</span>{%- endfor -%}
    </p>
  {%- endif -%}

  <nav class="az-pw__foot" aria-label="Rechtliches">
    <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
    <a href="/policies/legal-notice">Impressum</a>
    {%- if shop.privacy_policy -%}<a href="{{ shop.privacy_policy.url }}">Datenschutz</a>{%- endif -%}
  </nav>
</section>

<script>
  (function () {
    var root = document.querySelector('#shopify-section-{{ section.id }}');
    if (!root) return;
    // Video erst zeigen, wenn es wirklich läuft. Blockiert das Handy das Abspielen (z. B. Stromsparmodus),
    // bleibt das Standbild stehen, ohne Play-Knopf. Ein Versuch beim Laden, einer bei der ersten Berührung.
    var v = root.querySelector('video');
    // Nur am Desktop und nur einmal; danach bleibt das letzte Bild stehen. Am Handy bleibt es beim Startbild.
    if (v && window.matchMedia('(min-width: 900px)').matches && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      v.muted = true;
      v.addEventListener('playing', function () { root.classList.add('is-video'); });
      var spielen = function () { var p = v.play(); if (p && p.catch) p.catch(function () {}); };
      spielen();
      v.loop = false;
    }
    var c = root.querySelector('[data-az-count]');
    if (c) {
      var ziel = new Date(c.dataset.azCount).getTime();
      if (!isNaN(ziel)) {
        var f = function (t, n) { var el = c.querySelector('[data-t="' + t + '"]'); if (el) el.textContent = String(n).padStart(2, '0'); };
        var tick = function () {
          var r = Math.max(0, ziel - Date.now());
          f('d', Math.floor(r / 864e5)); f('h', Math.floor(r / 36e5) % 24); f('m', Math.floor(r / 6e4) % 60); f('s', Math.floor(r / 1e3) % 60);
          if (r === 0) clearInterval(iv);
        };
        c.hidden = false; tick(); var iv = setInterval(tick, 1000);
      }
    }
  })();
</script>

{% schema %}
{
  "name": "Azizam Passwortseite",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "video_url", "label": "Video (MP4, Desktop)" },
    { "type": "text", "id": "video_url_mobile", "label": "Video fürs Handy (MP4)" },
    { "type": "image_picker", "id": "poster", "label": "Startbild" },
    { "type": "text", "id": "kicker", "label": "Überzeile" },
    { "type": "text", "id": "wortmarke", "label": "Schriftzug", "default": "Azizam" },
    { "type": "text", "id": "persisch", "label": "Persisch", "default": "عزیزم" },
    { "type": "text", "id": "bedeutung", "label": "Bedeutung", "default": "mein Schatz" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Bald geht’s los." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Trag dich ein – du erfährst es zuerst." },
    { "type": "text", "id": "start_datum", "label": "Startdatum für den Countdown (optional)", "info": "Format 2026-12-21T18:00:00+01:00. Leer = kein Countdown." },
    { "type": "text", "id": "platzhalter", "label": "Platzhalter E-Mail", "default": "Deine E-Mail" },
    { "type": "text", "id": "button", "label": "Button", "default": "Eintragen" },
    { "type": "textarea", "id": "hinweis", "label": "Einwilligungstext", "default": "Mit dem Eintragen stimmst du E-Mails von Azizam zu. Abmelden jederzeit." },
    { "type": "text", "id": "erfolg", "label": "Bestätigung", "default": "Danke! Du erfährst es als Erstes." },
    { "type": "text", "id": "fakten", "label": "Faktenzeile (mit · trennen, optional)" },
    { "type": "checkbox", "id": "drop_zeigen", "label": "Düfte als Vorgeschmack zeigen", "default": true },
    { "type": "collection", "id": "kollektion", "label": "Kollektion (leer = Drop 1)" },
    { "type": "text", "id": "drop_titel", "label": "Titel über den Düften", "default": "Die ersten fünf" }
  ],
  "presets": [{ "name": "Azizam Passwortseite" }]
}
{% endschema %}
