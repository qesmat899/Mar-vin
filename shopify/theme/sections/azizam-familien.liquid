{{ 'azizam.css' | asset_url | stylesheet_tag }}
{%- comment -%} Duftkarte: drei Duftrichtungen als Spalten, Düfte mit Hauptnoten aus dem Metafeld azizam.noten. {%- endcomment -%}
<section class="az az-section" id="duftrichtungen" aria-labelledby="az-fam-{{ section.id }}">
  <div class="az-wrap">
    <div class="az-karte__head">
      <h2 id="az-fam-{{ section.id }}" class="az-h">{{ section.settings.heading }}</h2>
      {%- if section.settings.sub != blank -%}<p class="az-kicker">{{ section.settings.sub }}</p>{%- endif -%}
    </div>
    <div class="az-karte">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        <div class="az-karte__col" {{ block.shopify_attributes }}>
          <a class="az-karte__name" href="{{ c.url | default: routes.all_products_collection_url }}">{{ c.title | default: block.settings.fallback_title }}</a>
          <p class="az-karte__when">{{ block.settings.text }}</p>
          {%- if c != blank and c.products_count > 0 -%}
            <ul class="az-karte__list">
              {%- for p in c.products limit: 12 -%}
                <li><a href="{{ p.url }}">
                  <span class="az-karte__duft">{{ p.title }}</span>
                  {%- assign noten = p.metafields.azizam.noten.value -%}
                  {%- if noten != blank -%}<span class="az-karte__noten">{{ noten | join: ' · ' }}</span>{%- endif -%}
                </a></li>
              {%- endfor -%}
            </ul>
          {%- else -%}
            <p class="az-empty">Bald verfügbar.</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Azizam Duftkarte",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Die Düfte" },
    { "type": "text", "id": "sub", "label": "Zusatz", "default": "Von leicht bis intensiv" }
  ],
  "blocks": [{ "type": "familie", "name": "Duftrichtung", "settings": [
    { "type": "collection", "id": "collection", "label": "Kollektion" },
    { "type": "text", "id": "fallback_title", "label": "Titel, falls keine Kollektion" },
    { "type": "textarea", "id": "text", "label": "Wann" }
  ] }],
  "presets": [{ "name": "Azizam Duftkarte" }]
}
{% endschema %}
