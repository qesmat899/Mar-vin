{{ 'azizam.css' | asset_url | stylesheet_tag }}
<section class="az az-section" id="duftrichtungen" aria-labelledby="az-fam-{{ section.id }}">
  <div class="az-wrap">
    <p class="az-eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 id="az-fam-{{ section.id }}" class="az-h" style="font-size: clamp(2rem, 5vw, 3.2rem);">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="az-lead" style="margin-top:16px;">{{ section.settings.text }}</p>{%- endif -%}
    <div class="az-fam">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        <a class="az-fam__card az-fam__card--{{ block.settings.tone }}" href="{{ c.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          <span class="az-fam__no">{{ forloop.index | prepend: '0' }} · {{ block.settings.when }}</span>
          <span class="az-fam__title">{{ c.title | default: block.settings.fallback_title }}</span>
          <span class="az-fam__text">{{ block.settings.text }}</span>
          {%- if c != blank and c.products_count > 0 -%}
            <ul class="az-fam__list">
              {%- for p in c.products limit: 7 -%}<li>{{ p.title }}</li>{%- endfor -%}
            </ul>
          {%- endif -%}
          <span class="az-fam__more">Düfte ansehen →</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Azizam Duftrichtungen",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Überzeile", "default": "Von leicht bis intensiv" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Drei Duftrichtungen" },
    { "type": "textarea", "id": "text", "label": "Text" }
  ],
  "blocks": [{
    "type": "familie", "name": "Duftrichtung",
    "settings": [
      { "type": "collection", "id": "collection", "label": "Kollektion" },
      { "type": "text", "id": "fallback_title", "label": "Titel, falls keine Kollektion" },
      { "type": "text", "id": "when", "label": "Wann", "default": "Tag" },
      { "type": "textarea", "id": "text", "label": "Beschreibung" },
      { "type": "select", "id": "tone", "label": "Farbton", "default": "frisch",
        "options": [{ "value": "frisch", "label": "Frisch" }, { "value": "suess", "label": "Süß" }, { "value": "dunkel", "label": "Dunkel" }] }
    ]
  }],
  "presets": [{ "name": "Azizam Duftrichtungen" }]
}
{% endschema %}
