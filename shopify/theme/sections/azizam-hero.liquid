{{ 'azizam.css' | asset_url | stylesheet_tag }}
<section class="az az-hero" aria-labelledby="az-hero-{{ section.id }}">
  <div class="az-wrap az-hero__grid">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="az-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 id="az-hero-{{ section.id }}" class="az-h az-hero__title">{{ section.settings.title }}</h1>
      {%- if section.settings.persian != blank -%}<span class="az-hero__fa" lang="fa">{{ section.settings.persian }}</span>{%- endif -%}
      {%- if section.settings.subtitle != blank -%}<p class="az-hero__sub">{{ section.settings.subtitle }}</p>{%- endif -%}
      <hr class="az-rule">
      {%- if section.settings.text != blank -%}<div class="az-lead">{{ section.settings.text }}</div>{%- endif -%}
      <div class="az-hero__ctas">
        {%- if section.settings.cta_1_label != blank -%}
          <a class="az-btn az-btn--gold" href="{{ section.settings.cta_1_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_1_label }}</a>
        {%- endif -%}
        {%- if section.settings.cta_2_label != blank -%}
          <a class="az-btn az-btn--ghost" href="{{ section.settings.cta_2_link | default: '#anlass' }}">{{ section.settings.cta_2_label }}</a>
        {%- endif -%}
      </div>
    </div>
    <div class="az-hero__visual">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1100 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 900px) 440px, 80vw', alt: section.settings.image.alt | default: 'Azizam Flakon' }}
      {%- else -%}
        {% render 'azizam-flakon' %}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Azizam Hero",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Überzeile", "default": "Azizam Fragrance" },
    { "type": "text", "id": "title", "label": "Titel", "default": "Azizam" },
    { "type": "text", "id": "persian", "label": "Persischer Schriftzug", "default": "عزیزم" },
    { "type": "text", "id": "subtitle", "label": "Untertitel", "default": "Der Duft der zweiten Generation." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Azizam heißt auf Persisch „mein Schatz“. 19 Düfte in drei Duftrichtungen, jeder mit rund 30 % Duftöl.</p>" },
    { "type": "image_picker", "id": "image", "label": "Flakon-Bild (sonst Illustration)" },
    { "type": "text", "id": "cta_1_label", "label": "Button 1", "default": "Alle Düfte entdecken" },
    { "type": "url", "id": "cta_1_link", "label": "Button 1 Link" },
    { "type": "text", "id": "cta_2_label", "label": "Button 2", "default": "Duft nach Anlass finden" },
    { "type": "text", "id": "cta_2_link", "label": "Button 2 Link (z. B. #anlass)", "default": "#anlass" }
  ],
  "presets": [{ "name": "Azizam Hero" }]
}
{% endschema %}
