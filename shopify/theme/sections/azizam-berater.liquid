{%- comment -%}
  Azizam Duftberater: React-Insel (Quelle: shopify/berater/, Build → assets/azizam-berater.js/.css).
  Daten je Duft über das Snippet azizam-berater-produkt (Metafelder azizam.*, azizam_berater.*, azizam_profil.*).
  Mit „Berater-API“ prüft zusätzlich der Server mit Claude; ohne bzw. bei Fehlern rechnet der Browser allein.
  Jahreszeit setzt der Berater automatisch.
  Das Skript (~100 KB) lädt erst, wenn der Berater in die Nähe kommt, ein Link auf #duftberater geklickt wird
  oder die Seite mit #duftberater geöffnet wurde. So bleibt der Seitenstart schnell.
  Ohne JavaScript bleibt der Hinweis mit Link zur Kollektion stehen.
{%- endcomment -%}
{{ 'azizam-berater.css' | asset_url | stylesheet_tag }}
<section class="azb" id="duftberater" aria-label="{{ section.settings.heading | escape }}"
  data-azizam-berater
  data-kicker="{{ section.settings.kicker | escape }}"
  data-heading="{{ section.settings.heading | escape }}"
  data-discovery="{{ section.settings.discovery_url | default: '/products/probierset' }}"
  data-api="{{ section.settings.api_url | escape }}"
  data-src="{{ 'azizam-berater.js' | asset_url }}">
  <div data-berater-app style="min-height: 560px">
    <noscript>
      <div style="max-width:1280px;margin:0 auto;padding:80px 16px">
        <p>{{ section.settings.heading }}</p>
        <p><a href="{{ routes.all_products_collection_url }}">Alle Düfte ansehen</a></p>
      </div>
    </noscript>
  </div>
  <script type="application/json" data-produkte>
    [
    {%- assign erster = true -%}
    {%- for produkt in collections.all.products limit: 60 -%}
      {%- if produkt.type == 'Probenset' or produkt.metafields.azizam_berater.anlass.value == blank -%}{%- continue -%}{%- endif -%}
      {%- unless erster -%},{%- endunless -%}{%- assign erster = false -%}
      {%- render 'azizam-berater-produkt', produkt: produkt -%}
    {%- endfor -%}
    ]
  </script>
</section>
<script>
  (function () {
    var root = document.getElementById('duftberater');
    if (!root || root.dataset.laden) return;
    var geladen = false;
    function laden() {
      if (geladen) return;
      geladen = true;
      root.dataset.laden = '1';
      var s = document.createElement('script');
      s.src = root.dataset.src;
      s.defer = true;
      document.head.appendChild(s);
    }
    if (location.hash === '#duftberater' || !('IntersectionObserver' in window) || {{ request.design_mode | json }}) { laden(); return; }
    var io = new IntersectionObserver(function (es) {
      if (es.some(function (e) { return e.isIntersecting; })) { io.disconnect(); laden(); }
    }, { rootMargin: '900px 0px' });
    io.observe(root);
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[href*="#duftberater"]');
      if (a) laden();
    });
  })();
</script>
{% schema %}
{
  "name": "Azizam Duftberater",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Überzeile", "default": "Duftberater · in wenigen Fragen" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Finde deinen Duft für jetzt." },
    { "type": "url", "id": "discovery_url", "label": "Link Probierset" },
    { "type": "text", "id": "api_url", "label": "Berater-API (KI)", "info": "Adresse des Duftberater-Servers, z. B. https://…vercel.app/api/beratung. Leer = Berater rechnet nur im Browser, ohne KI." }
  ],
  "presets": [{ "name": "Azizam Duftberater" }]
}
{% endschema %}
