{%- comment -%}
  Azizam Duftberater: React-Insel (Quelle: shopify/berater/, Build → assets/azizam-berater.js/.css).
  Daten je Duft aus den Metafeldern azizam.* (familie, noten, charakter, intensitaet, tageszeit) und
  azizam_berater.* (tendenz, stimmung, saison, anlass, nicht_buero). Jahreszeit setzt der Berater automatisch.
  Ohne JavaScript bleibt der Hinweis mit Link zur Kollektion stehen.
{%- endcomment -%}
{{ 'azizam-berater.css' | asset_url | stylesheet_tag }}
<section class="azb" id="duftberater" aria-label="{{ section.settings.heading | escape }}"
  data-azizam-berater
  data-kicker="{{ section.settings.kicker | escape }}"
  data-heading="{{ section.settings.heading | escape }}"
  data-discovery="{{ section.settings.discovery_url | default: '/products/discovery-set' }}">
  <div data-berater-app>
    <noscript>
      <div style="max-width:1280px;margin:0 auto;padding:80px 16px">
        <p>{{ section.settings.heading }}</p>
        <p><a href="{{ routes.all_products_collection_url }}">Alle Düfte ansehen</a></p>
      </div>
    </noscript>
  </div>
  <script type="application/json" data-produkte>
    [
    {%- assign erster = true -%}
    {%- for p in collections.all.products limit: 60 -%}
      {%- if p.type == 'Probenset' or p.metafields.azizam_berater.anlass.value == blank -%}{%- continue -%}{%- endif -%}
      {%- assign bild = p.media[1] | default: p.media[0] -%}
      {%- unless erster -%},{%- endunless -%}{%- assign erster = false -%}
      {
        "t": {{ p.title | json }},
        "u": {{ p.url | json }},
        "p": {{ p.price_min | money | json }},
        "img": {% if bild %}{{ bild.preview_image | image_url: width: 1100 | json }}{% else %}null{% endif %},
        "img2": {% if p.media[0] %}{{ p.media[0].preview_image | image_url: width: 300 | json }}{% else %}null{% endif %},
        "familie": {{ p.metafields.azizam.familie.value | json }},
        "noten": {{ p.metafields.azizam.noten.value | json }},
        "charakter": {{ p.metafields.azizam.charakter.value | json }},
        "intensitaet": {{ p.metafields.azizam.intensitaet.value | default: 3 | json }},
        "tageszeit": {{ p.metafields.azizam.tageszeit.value | json }},
        "tendenz": {{ p.metafields.azizam_berater.tendenz.value | json }},
        "stimmung": {{ p.metafields.azizam_berater.stimmung.value | json }},
        "saison": {{ p.metafields.azizam_berater.saison.value | json }},
        "anlass": {{ p.metafields.azizam_berater.anlass.value | json }},
        "nicht_buero": {{ p.metafields.azizam_berater.nicht_buero.value | default: false | json }}
      }
    {%- endfor -%}
    ]
  </script>
</section>
<script src="{{ 'azizam-berater.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "Azizam Duftberater",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Überzeile", "default": "Duftberater · 4 Fragen" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Finde deinen Duft für jetzt." },
    { "type": "url", "id": "discovery_url", "label": "Link Discovery-Set" }
  ],
  "presets": [{ "name": "Azizam Duftberater" }]
}
{% endschema %}
