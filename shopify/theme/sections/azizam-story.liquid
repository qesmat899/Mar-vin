{{ 'azizam.css' | asset_url | stylesheet_tag }}
<section class="az az-section" aria-labelledby="az-story-{{ section.id }}">
  <div class="az-wrap az-story">
    <div>
      <div class="az-story__word" lang="fa" aria-hidden="true">{{ section.settings.word }}</div>
      <p class="az-eyebrow" style="margin-top:18px;">{{ section.settings.eyebrow }}</p>
    </div>
    <div class="az-story__text">
      <h2 id="az-story-{{ section.id }}" class="az-h" style="font-size: clamp(1.8rem, 4vw, 2.6rem); margin-bottom: 20px;">{{ section.settings.heading }}</h2>
      {{ section.settings.text }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Azizam Geschichte",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "word", "label": "Wort", "default": "عزیزم" },
    { "type": "text", "id": "eyebrow", "label": "Überzeile", "default": "Azizam – mein Schatz" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Ein Wort, das man nicht übersetzt, sondern fühlt." },
    { "type": "richtext", "id": "text", "label": "Text" }
  ],
  "presets": [{ "name": "Azizam Geschichte" }]
}
{% endschema %}
