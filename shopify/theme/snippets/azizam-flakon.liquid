{%- comment -%}
  Platzhalter-Flakon (zylindrisch, Goldkappe) als SVG, bis echte Produktbilder vorliegen.
  Kein echtes Produktfoto. Parameter: label (Text auf dem Etikett, optional)
{%- endcomment -%}
<svg class="az-flakon" viewBox="0 0 200 420" role="img" aria-label="Azizam Flakon (Illustration)">
  <defs>
    <linearGradient id="az-glass" x1="0" x2="1">
      <stop offset="0" stop-color="#2a2219"/><stop offset=".18" stop-color="#5a4630"/>
      <stop offset=".5" stop-color="#3a2d1f"/><stop offset=".82" stop-color="#6b5436"/><stop offset="1" stop-color="#241c14"/>
    </linearGradient>
    <linearGradient id="az-cap" x1="0" x2="1">
      <stop offset="0" stop-color="#8a6b2e"/><stop offset=".35" stop-color="#e8d29b"/>
      <stop offset=".6" stop-color="#c8a45a"/><stop offset="1" stop-color="#7a5d24"/>
    </linearGradient>
    <linearGradient id="az-shine" x1="0" x2="1">
      <stop offset="0" stop-color="#fff" stop-opacity="0"/><stop offset=".5" stop-color="#fff" stop-opacity=".22"/><stop offset="1" stop-color="#fff" stop-opacity="0"/>
    </linearGradient>
  </defs>
  <rect x="62" y="8" width="76" height="96" rx="6" fill="url(#az-cap)"/>
  <rect x="62" y="96" width="76" height="6" fill="#5c461d" opacity=".6"/>
  <rect x="78" y="102" width="44" height="18" fill="#3b2f20"/>
  <rect x="40" y="118" width="120" height="292" rx="14" fill="url(#az-glass)"/>
  <rect x="52" y="128" width="14" height="270" rx="7" fill="url(#az-shine)"/>
  <rect x="40" y="370" width="120" height="40" rx="14" fill="#000" opacity=".25"/>
  <line x1="62" y1="236" x2="138" y2="236" stroke="#c8a45a" stroke-width=".8"/>
  <text x="100" y="262" text-anchor="middle" fill="#e8d29b" font-family="Georgia, serif" font-size="20" letter-spacing="3">AZIZAM</text>
  <line x1="62" y1="276" x2="138" y2="276" stroke="#c8a45a" stroke-width=".8"/>
  {%- if label != blank -%}
    <text x="100" y="298" text-anchor="middle" fill="#a89e8f" font-family="Georgia, serif" font-size="10" letter-spacing="2">{{ label | upcase | escape }}</text>
  {%- endif -%}
</svg>
