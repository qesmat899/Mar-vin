# Duftberater-Server – Umgebungsvariablen (Werte nur in Vercel → Project → Settings → Environment Variables eintragen,
# nie in diese Datei, nie ins Repo, nie ins Theme).
ANTHROPIC_API_KEY=
# Modell zentral wählbar (Standard: claude-sonnet-5-5)
ANTHROPIC_MODEL=claude-sonnet-5-5
# Denktiefe: low | medium | high (Standard: medium)
ANTHROPIC_EFFORT=medium
# Zeitlimit je Versuch in ms (das SDK wiederholt temporäre Fehler bis zu 2-mal)
ANTHROPIC_TIMEOUT_MS=20000
# Serverseitiger Ersatz bei Ablehnung durch Sicherheitsfilter: "aus" zum Abschalten
ANTHROPIC_FALLBACK=
# Schutz vor Missbrauch und Kosten
MAX_KI_BERATUNGEN_PRO_TAG=300
MAX_BERATUNGEN_PRO_IP_STUNDE=20
ERLAUBTE_HERKUNFT=https://azizamfragrances.com,https://www.azizamfragrances.com,https://pbznmb-fy.myshopify.com
# Produktdaten-Feed aus dem Theme (Template collection.berater)
SHOP_DATEN_URL=https://azizamfragrances.com/collections/all?view=berater
# Nur bis die Theme-Kopie veröffentlicht ist: ID der unveröffentlichten Kopie (danach löschen)
SHOP_VORSCHAU_THEME_ID=
# Zugang zur Kostenübersicht /api/kosten (langes Zufallswort)
ADMIN_TOKEN=
# Optional: dauerhafter Speicher (Upstash Redis über den Vercel Marketplace) für Kosten, Cache, Rate-Limit
KV_REST_API_URL=
KV_REST_API_TOKEN=
